---
import Layout from '../layouts/Layout.astro';
import { business } from '../config/business';
---
<Layout title="ประกาศความเป็นส่วนตัว | Winner IT" description="แนวทางการใช้ข้อมูลผู้ติดต่อเพื่อประเมินรับซื้อสินค้าไอที การคุ้มครองข้อมูลและช่องทางติดต่อผู้ดูแลข้อมูลของ Winner IT">
  <section class="container privacy">
    <h1>ประกาศเกี่ยวกับข้อมูลส่วนบุคคล</h1>
    <p>Winner IT ดำเนินการโดย <strong>{business.legalName}</strong> ใช้ข้อมูลที่ผู้ติดต่อส่งให้ทางแบบฟอร์มเพื่อรับเรื่องและติดต่อกลับเกี่ยวกับการประเมินสินค้าที่ผู้ติดต่อร้องขอเท่านั้น</p>
    <h2>ข้อมูลที่เรารับ</h2>
    <p>ชื่อผู้ติดต่อ เบอร์โทรหรืออีเมล ประเภทอุปกรณ์ รายละเอียดที่ผู้ติดต่อกรอก และข้อมูลที่มาของการติดต่อซึ่งเกี่ยวข้องกับคำขอ เช่น หน้าที่ส่งแบบฟอร์มและแคมเปญโดยไม่มีข้อมูลระบุตัวตนในระบบวัดจำนวนคลิก</p>
    <h2>การใช้และส่งต่อข้อมูล</h2>
    <p>ข้อมูลจากฟอร์มอาจส่งผ่านระบบรับแจ้งของบริษัทไปยังทีมงานที่ได้รับมอบหมายเพื่อพิจารณาและติดต่อตอบกลับ ห้ามส่งข้อมูลสำคัญ เช่น รหัสผ่าน เลขบัตรประชาชน หรือเลขบัญชีธนาคารผ่านช่องข้อความของแบบฟอร์ม</p>
    <h2>การปกป้องและระยะเวลาจัดเก็บ</h2>
    <p>แบบฟอร์มใช้การตรวจสอบป้องกันบอตและส่งผ่านการเชื่อมต่อ HTTPS ระบบวัดการคลิก LINE และโทรศัพท์บันทึกเฉพาะประเภทเหตุการณ์ หน้าเว็บ และแหล่งแคมเปญ ไม่บันทึกชื่อ อีเมล หรือเบอร์โทรใน Analytics การจัดเก็บข้อมูลคำขอและการลบเมื่อหมดความจำเป็นต้องเป็นไปตามนโยบายของบริษัทและระบบรับแจ้งที่ใช้งานจริง</p>
    <h2>การขอแก้ไขหรือใช้สิทธิเกี่ยวกับข้อมูล</h2>
    <p>ผู้ติดต่อสามารถสอบถาม ขอแก้ไข หรือขอลบข้อมูลคำขอที่เก็บไว้ตามสิทธิที่กฎหมายกำหนด โดยติดต่อ <a href={`mailto:${business.email}`}>{business.email}</a> หรือ LINE <a href={business.lineUrl} target="_blank" rel="noopener noreferrer">{business.lineId}</a></p>
    <p>ที่ตั้งสำนักงาน: {business.fullAddress} · โทร <a href={business.phoneHref}>{business.phoneDisplay}</a></p>
  </section>
</Layout>
<style>.privacy{max-width:820px;padding-top:66px;padding-bottom:84px}.privacy h1{font-size:clamp(30px,4vw,42px)}.privacy h2{margin-top:36px;font-size:23px}.privacy p{color:var(--muted);line-height:1.9}.privacy a{color:var(--accent-hover);text-decoration:underline}</style>
