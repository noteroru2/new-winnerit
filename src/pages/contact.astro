---
import Layout from '../layouts/Layout.astro';
import TrustProof from '../components/site/TrustProof.astro';
import { business } from '../config/business';
---

<Layout title="ติดต่อ — Winner IT" description="ติดต่อ Winner IT เพื่อประเมินราคาอุปกรณ์ IT มือสอง แอดไลน์ @WEBUY หรือส่งอีเมลได้ทันที">
	<section class="hero">
		<div class="hero-bg"></div>
		<div class="container hero-inner">
			<span class="pill">ติดต่อเรา</span>
			<h1>ติดต่อทีมงาน Winner IT</h1>
			<p class="lead">
				แอดไลน์ @WEBUY ส่งรูปพร้อมรายละเอียดอุปกรณ์ หรือกรอกฟอร์มด้านล่างเพื่อให้ทีมงานติดต่อกลับ
			</p>
		</div>
	</section>

	<section class="body-sec">
		<div class="container">
			<!-- Quick Contact Cards -->
			<div class="quick-grid">
				<a href={business.lineUrl} target="_blank" rel="noopener" class="q-card q-line">
					<svg width="28" height="28" viewBox="0 0 24 24" fill="#06C755"><path d="M12 2C6.48 2 2 5.83 2 10.44c0 4.17 3.7 7.66 8.69 8.32.34.07.8.23.91.52.1.27.07.68.03.95l-.15.88c-.04.25-.2.99.87.54s5.78-3.4 7.88-5.82C22.08 13.79 22 12.16 22 10.44 22 5.83 17.52 2 12 2z"/></svg>
					<strong>Line @WEBUY</strong>
					<span>วิธีที่เร็วที่สุดในการติดต่อเรา</span>
				</a>
				<a href={business.phoneHref} class="q-card q-email">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.63a2 2 0 0 1-.45 2.11L8 9.73a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.85.29 1.73.5 2.63.62A2 2 0 0 1 22 16.92z"/></svg>
					<strong>{business.phoneDisplay}</strong>
					<span>โทรสอบถามและนัดหมาย</span>
				</a>
				<a href={`mailto:${business.email}`} class="q-card q-email">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="M22 4l-10 8L2 4"/></svg>
					<strong>{business.email}</strong>
					<span>ส่งอีเมลถึงทีมงาน</span>
				</a>
			</div>

			<div class="g2">
				<div class="box">
					<h2>แบบฟอร์มติดต่อ</h2>
					<div id="form-offline" class="contact-offline" role="status">
            กำลังตรวจสอบระบบรับข้อความ หากแบบฟอร์มยังไม่พร้อม กรุณาส่งรายละเอียดเครื่องผ่าน <a href={business.lineUrl} target="_blank" rel="noopener noreferrer">LINE {business.lineId}</a>
          </div>
          <form id="winner-contact" class="form" hidden novalidate>
            <p class="form-hint">เมื่อส่งแบบฟอร์ม ระบบจะนำข้อมูลไปยังทีมงานผ่านช่องทางรับแจ้งที่ตั้งค่าไว้ และแจ้งหมายเลขอ้างอิงให้คุณ ไม่มีการส่งโดยเปิดโปรแกรมอีเมล</p>
            <label><span class="lb">ชื่อผู้ติดต่อ *</span><input name="name" required maxlength="90" class="inp" autocomplete="name" placeholder="ชื่อผู้ติดต่อ" /></label>
            <label><span class="lb">เบอร์ติดต่อ</span><input name="phone" type="tel" maxlength="30" class="inp" autocomplete="tel" placeholder="เบอร์โทรสำหรับติดต่อกลับ" /></label>
            <label><span class="lb">อีเมล</span><input type="email" name="email" maxlength="120" class="inp" autocomplete="email" placeholder="email@example.com" /></label>
            <p class="form-hint">โปรดระบุเบอร์โทรหรืออีเมลอย่างน้อยหนึ่งช่อง</p>
            <label><span class="lb">อุปกรณ์ที่ต้องการขาย *</span>
              <select name="category" required class="inp">
                <option value="">เลือกประเภท</option>
                <option value="notebook">โน๊ตบุ๊ค / Gaming Laptop</option>
                <option value="pc">คอมพิวเตอร์ PC / การ์ดจอ</option>
                <option value="macbook">MacBook / iMac</option>
                <option value="iphone">iPhone</option>
                <option value="ipad">iPad</option>
                <option value="camera">กล้อง / เลนส์</option>
                <option value="lot">งานเหมาล็อตองค์กร</option>
                <option value="other">อุปกรณ์อื่น</option>
              </select>
            </label>
            <label><span class="lb">รายละเอียดเครื่องและสภาพ *</span><textarea name="message" rows={6} minlength="20" maxlength="2500" required class="inp ta" placeholder="รุ่น สเปก สภาพ ตำหนิ จำนวน และจังหวัด..."></textarea></label>
            <div class="trap" aria-hidden="true"><label>Website<input name="companyWebsite" tabindex="-1" autocomplete="off" /></label></div>
            <label class="consent"><input type="checkbox" name="consent" required /> ยินยอมให้ Winner IT ใช้ข้อมูลนี้เพื่อติดต่อเกี่ยวกับการประเมินสินค้าและดำเนินการตามคำขอ โดยไม่เผยแพร่รายละเอียดส่วนตัวต่อสาธารณะ</label>
            <div id="winner-turnstile"></div>
            <p id="form-status" role="status" aria-live="polite"></p>
            <button class="btn btn-primary btn-big" id="winner-submit" type="submit">ส่งข้อมูลให้ทีมงาน</button>
          </form>
				</div>

				<div class="box">
					<h2>ที่ตั้งร้าน</h2>
					<p class="address">{business.fullAddress}<br />เปิดทุกวัน {business.opens}–{business.closes} น.</p>
					<div class="map">
						<iframe title="แผนที่ Winner IT อุบลราชธานี" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={`https://www.google.com/maps?q=${business.latitude},${business.longitude}&z=17&output=embed`}></iframe>
					</div>
					<a class="map-link" href={business.googleMapsUrl} target="_blank" rel="noopener noreferrer">เปิดใน Google Maps และดูรีวิวล่าสุด →</a>
				</div>
			</div>
		</div>
	</section>
	<TrustProof compact />
</Layout>

<script>
 import '../scripts/leadTracking';
 import '../scripts/contactForm';
</script>

<style>
	.hero {
		position: relative;
		padding: 80px 0 64px;
		text-align: center;
		overflow: hidden;
	}
	.hero-bg {
		position: absolute;
		inset: 0;
		background: linear-gradient(168deg, #fff7ed 0%, #fffbf5 30%, #fff 60%);
		z-index: 0;
	}
	.hero-inner {
		position: relative;
		z-index: 1;
		animation: fadeUp .6s var(--ease-out) both;
	}
	@keyframes fadeUp {
		from { opacity: 0; transform: translateY(20px); }
		to { opacity: 1; transform: translateY(0); }
	}
	.hero h1 {
		font-size: 42px;
		margin: 16px 0 0;
		letter-spacing: -.03em;
	}
	.lead {
		margin: 16px auto 0;
		font-size: 17px;
		color: var(--muted);
		line-height: 1.75;
		max-width: 600px;
	}

	.body-sec {
		padding: 48px 0 80px;
	}

	.quick-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
		margin-bottom: 28px;
	}
	.q-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		padding: 28px 24px;
		border-radius: 16px;
		background: #fff;
		border: 1.5px solid var(--border);
		text-decoration: none;
		color: var(--text);
		box-shadow: var(--shadow-card);
		transition: all .3s var(--ease-out);
		text-align: center;
	}
	.q-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-hover);
	}
	.q-line:hover { border-color: #06C755; }
	.q-email:hover { border-color: var(--accent); }
	.q-card strong {
		font-size: 16px;
		font-weight: 700;
	}
	.q-card span {
		font-size: 13px;
		color: var(--muted);
	}

	.g2 {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 28px;
	}
	.box {
		background: #fff;
		border: 1px solid var(--border);
		border-radius: 20px;
		padding: 36px;
		box-shadow: var(--shadow-card);
	}
	.box h2 {
		margin: 0 0 24px;
		font-size: 22px;
	}

	.contact-offline { padding: 18px; background: #fff7ed; border-radius: 12px; line-height: 1.8; }
	.contact-offline a { color: var(--accent-hover); font-weight: 700; }
	.form[hidden] { display: none; }
	.form-hint { margin: 0; font-size: 13px; line-height: 1.7; color: var(--muted); }
	.trap { position: absolute; left: -9999px; height: 0; overflow: hidden; }
	.consent { display: flex; align-items: flex-start; gap: 10px; line-height: 1.6; font-size: 13px; }
	.consent input { margin-top: 4px; }
	.form {
		display: grid;
		gap: 18px;
	}
	label {
		display: grid;
		gap: 6px;
	}
	.lb {
		font-weight: 600;
		font-size: 14px;
		color: var(--text);
	}
	.inp {
		padding: 13px 16px;
		border-radius: 12px;
		border: 1.5px solid var(--border);
		background: var(--bg-alt);
		color: var(--text);
		font-size: 15px;
		font-family: inherit;
		transition: all .25s var(--ease-out);
	}
	.inp::placeholder {
		color: var(--muted);
		opacity: .5;
	}
	.inp:focus {
		outline: none;
		border-color: var(--accent);
		background: #fff;
		box-shadow: 0 0 0 4px rgba(249,115,22,.08);
	}
	.ta { resize: vertical; min-height: 120px; }

	.map {
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid var(--border);
		box-shadow: var(--shadow-xs);
		height: 100%;
		min-height: 300px;
	}
	.map iframe {
		border: 0;
		width: 100%;
		height: 100%;
		min-height: 300px;
		display: block;
	}
	.address { color: var(--muted); line-height: 1.7; margin: -10px 0 18px; }
	.map-link { display: inline-block; margin-top: 16px; color: var(--accent); font-weight: 700; text-decoration: none; }

	@media (max-width: 900px) {
		.hero h1 { font-size: 34px; }
		.quick-grid { grid-template-columns: 1fr; }
		.g2 { grid-template-columns: 1fr; }
	}
</style>
