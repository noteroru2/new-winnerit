---
import RealBuybackPage from '../components/site/RealBuybackPage.astro';
const checklist = [
{ title:'รุ่นเครื่องและสเปก', text:'แจ้งยี่ห้อ รุ่นเต็มหรือ Part Number รุ่น CPU และปีหรือ Generation รุ่น GPU (ถ้ามี) ความจุ RAM และ SSD/HDD; แนบภาพหน้า System Information หรือ About หากไม่ทราบรุ่น' },
{ title:'รูปภายนอกครบทุกมุม', text:'ถ่ายด้านหน้า ฝาหลัง ขอบเครื่อง มุมบานพับ แป้นพิมพ์และหน้าจอเปิดเครื่อง ภาพควรเห็นรอยแตก บุบ หรือสีจอผิดปกติชัดเจน' },
{ title:'สภาพการทำงาน', text:'แจ้งการเปิดติด ระบบปฏิบัติการ การชาร์จ แบตเตอรี่และอาการผิดปกติ เช่น ดับเอง พัดลมดัง ภาพกระพริบ หรือคีย์บอร์ดบางปุ่มไม่ทำงาน' },
{ title:'อุปกรณ์ที่มี', text:'มีสายชาร์จแท้/เทียบ กล่อง ใบเสร็จ หรือประกันเหลือหรือไม่ อุปกรณ์ที่ขาดอาจมีผลต่อต้นทุนการขายต่อ' },
{ title:'การล็อกและสิทธิ์ครอบครอง', text:'แจ้งว่ามีรหัส BIOS, BitLocker, บัญชีองค์กร หรือระบบจัดการเครื่อง (MDM) หรือไม่ และตรวจสิทธิ์การขายก่อนส่งเครื่อง' },
{ title:'ตำหนิและการซ่อม', text:'แจ้งการเปลี่ยนจอ แบตเตอรี่ บานพับ เมนบอร์ด หรือการโดนน้ำตามที่ทราบ หลีกเลี่ยงการปกปิดอาการเพราะราคาจะต้องประเมินใหม่เมื่อพบปัญหา' },
];
const checks=[
{title:'CPU / GPU และประสิทธิภาพ',text:'ตรวจรุ่นจริงจากระบบและดูว่า GPU แยกทำงานได้หรือไม่ สำหรับ Gaming Laptop พิจารณาความร้อนผิดปกติ ภาพลาย และประสิทธิภาพระหว่างทดสอบตามความเหมาะสม'},
{title:'RAM / SSD / สุขภาพไดรฟ์',text:'ยืนยันความจุจริง ตรวจการมองเห็นไดรฟ์และข้อมูลสุขภาพเบื้องต้น เช่น S.M.A.R.T. เมื่ออุปกรณ์รองรับ'},
{title:'จอภาพและพอร์ต',text:'ตรวจจุดสว่าง/จุดมืด สีจอ ภาพกระพริบ รวมถึง USB, HDMI, Wi-Fi, ลำโพงและกล้องตามรุ่น'},
{title:'แบตเตอรี่ / ที่ชาร์จ',text:'เปรียบเทียบความจุที่ออกแบบกับความจุปัจจุบันเมื่อระบบรายงานได้ และทดสอบการรับไฟ; แบตเสื่อมควรแจ้งตรงไปตรงมา'},
{title:'ฝาเครื่องและบานพับ',text:'ตรวจรอยแตกบริเวณฝาครอบ จุดยึดน็อต บานพับฝืด หรือจออ้า เพราะบางรุ่นค่าซ่อมโครงสร้างสูง'},
{title:'บัญชีและความปลอดภัย',text:'ตรวจรหัส BIOS, บัญชีองค์กร และสถานะการเข้ารหัสก่อนตกลงรับซื้อ แนะนำผู้ขายสำรองและจัดการข้อมูลตนเองก่อนส่งมอบ'},
];
const scenarios=[
{name:'ตัวอย่าง A — Gaming Laptop สเปกเดียวกันแต่บานพับต่างกัน',situation:'เครื่อง Ryzen 7 / RTX 3050 / RAM 16GB / SSD 512GB สองเครื่อง รุ่นเดียวกัน แต่เครื่องหนึ่งบานพับแตกและแบตเตอรี่เสื่อม',checking:'ตรวจจอและสายแพ ความเสียหายโครงฝาหลัง ค่าอะไหล่ ความร้อนและ GPU แยก',impact:'ไม่ควรใช้ราคากลางเดียวกัน ต้องแยกต้นทุนซ่อมและความเสี่ยงก่อนเสนอราคาซื้อ'},
{name:'ตัวอย่าง B — โน๊ตบุ๊คธุรกิจที่ขาด SSD',situation:'โน๊ตบุ๊ค Core i5 Gen 11 พร้อม RAM แต่ไม่มี SSD และไม่ทราบสถานะแบตเตอรี่',checking:'ทดสอบเปิด BIOS ตรวจ CPU/RAM จอ พอร์ต แบตเตอรี่ และสถานะล็อก BIOS/องค์กร',impact:'ราคาประเมินต้องเผื่อค่า SSD การติดตั้งและความเสี่ยงเครื่องที่ยังทดสอบไม่ครบ'},
];
const faqs=[
{question:'โน๊ตบุ๊คจอแตก เปิดไม่ติด หรือแบตเตอรี่เสื่อม ยังส่งประเมินได้ไหม?',answer:'ส่งรายละเอียดได้ ทีมงานจะพิจารณาตามรุ่นและอาการ ไม่รับประกันว่าจะรับซื้อได้ทุกเครื่อง และต้องแยกราคาซ่อมกับความเสี่ยงของเครื่องที่ยังทดสอบไม่ได้'},
{question:'ทราบราคารับซื้อจากแค่รูปได้เลยหรือไม่?',answer:'แจ้งได้เป็นราคาเบื้องต้นเมื่อข้อมูลเพียงพอ แต่ราคาสุดท้ายต้องยืนยันหลังตรวจสเปก สภาพจริง และอุปกรณ์ที่ได้รับ'},
{question:'อยู่ต่างจังหวัดขายได้อย่างไร?',answer:'ติดต่อ LINE ก่อนเพื่อสอบถามเงื่อนไขและวิธีจัดส่ง ไม่ควรส่งเครื่องก่อนตกลงขั้นตอนการรับและตรวจสอบ'},
{question:'มีประกันเหลือทำให้ราคาเพิ่มขึ้นหรือไม่?',answer:'อาจมีผล หากยืนยันวันหมดประกันและเงื่อนไขโอนได้ แต่ต้องพิจารณารุ่นและสภาพจริงร่วมกัน'},
{question:'ต้องลบข้อมูลก่อนขายหรือไม่?',answer:'ควรสำรองและลบข้อมูลด้วยตนเอง ออกจากบัญชีและแจ้งหากเป็นเครื่ององค์กร ทีมงานจะยืนยันขั้นตอนจัดการข้อมูลตามสภาพอุปกรณ์ ไม่รับรองว่าลบแบบกู้คืนไม่ได้ในทุกกรณี'},
];
---
<RealBuybackPage category="รับซื้อโน๊ตบุ๊ค" title="รับซื้อโน๊ตบุ๊คมือสอง | ตรวจสเปก สภาพ แบตเตอรี่ก่อนประเมิน — Winner IT" description="รับประเมินโน๊ตบุ๊คมือสอง Gaming Laptop และเครื่องทำงาน ส่งรุ่น CPU GPU RAM SSD ภาพตำหนิและแบตเตอรี่ผ่าน LINE @WEBUY ยืนยันราคาหลังตรวจจริง มีหน้าร้านอุบลราชธานี" headline="รับซื้อโน๊ตบุ๊คมือสอง ประเมินตามสเปกและสภาพจริง" introduction="Winner IT ดำเนินงานโดยบริษัท อำพล เทรดดิ้ง จำกัด มีหน้าร้านในอุบลราชธานี ผู้ขายส่งรายละเอียดเครื่องให้ประเมินเบื้องต้นผ่าน LINE ได้ฟรี เราอธิบายว่าต้องตรวจอะไรเป็นรายเครื่องก่อนยืนยันราคา ไม่ใช้ตัวเลขราคาเดียวกับทุกสภาพเครื่อง" checklist={checklist} checks={checks} scenarios={scenarios} faqs={faqs} serviceUrl="/รับซื้อโน๊ตบุ๊ค/" related={[{title:'รับซื้อคอมพิวเตอร์ PC',url:'/รับซื้อคอมพิวเตอร์/'},{title:'รับซื้อ MacBook',url:'/รับซื้อmacbook/'},{title:'ติดต่อร้าน',url:'/contact/'}]} />
